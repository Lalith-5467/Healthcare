datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  PATIENT
  DOCTOR
  NURSE
  PHARMACIST
  CAREGIVER
  INSURANCE_PROVIDER
  ADMIN
  SUPER_ADMIN
}

enum RecordType {
  LAB_REPORT
  PRESCRIPTION
  CONSULTATION
  IMAGING
  DISCHARGE
  VACCINATION
  OTHER
}

enum AppointmentType {
  VIDEO
  IN_PERSON
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ConsultationStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PrescriptionStatus {
  PENDING_REVIEW
  REVIEWED
  CONFIRMED
  PHARMACY_ORDER_CREATED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  DECLINED
  CONFIRMED
  PREPARING
  READY
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
}

enum ReminderType {
  MEDICATION
  APPOINTMENT
  CHECKUP
  REFILL
  OTHER
}

enum ReminderStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

// ============================================================
// 1. CORE IDENTITY & AUTH
// ============================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(PATIENT)
  abhaId       String?  @unique
  phoneNumber  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 1-to-1 Profile Relations
  patient           Patient?
  doctor            Doctor?
  nurse             Nurse?
  pharmacist        Pharmacist?
  caregiver         Caregiver?
  insuranceProvider InsuranceProvider?

  // System Relations
  notifications  Notification[]
  auditLogs      AuditLog[]
  recordedVitals Vital[]        @relation("VitalRecorder")

  @@map("users")
}

// ============================================================
// 2. ROLE PROFILES
// ============================================================

model Patient {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName              String
  gender                String?
  dateOfBirth           DateTime?
  bloodGroup            String?
  address               String?   @db.Text
  emergencyContactName  String?
  emergencyContactPhone String?
  familyPhone          String?
  heightCm             Float?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Clinical Relations
  appointments         Appointment[]
  prescriptions        Prescription[]
  medicalRecords       MedicalRecord[]
  vitals               Vital[]
  reminders            Reminder[]
  pharmacyOrders       PharmacyOrder[]
  careRequests         CareRequest[]
  healthShareTokens    HealthShareToken[]
  patientAccessRequests PatientAccessRequest[]
  patientMedications   PatientMedication[]
  doseLogs             DoseLog[]
  caregiverTasks       CaregiverTask[]
  insurancePolicies    InsurancePolicy[]
  insuranceClaims      InsuranceClaim[]

  // Linked Caregivers (M:N)
  caregivers    Caregiver[]    @relation("PatientCaregivers")
  consultations Consultation[]

  @@map("patients")
}

model Doctor {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName        String
  speciality      String
  qualification   String?
  licenseNumber   String?  @unique
  hospital        String?
  experienceYears Int      @default(0)
  consultationFee Decimal  @default(0.0) @db.Decimal(10, 2)
  photoUrl        String?  @db.Text
  about           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  appointments     Appointment[]
  prescriptions    Prescription[]
  medicalRecords   MedicalRecord[]
  patientAccessRequests PatientAccessRequest[]
  consultations    Consultation[]

  @@map("doctors")
}

model Nurse {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName      String
  hospital      String?
  department    String?
  licenseNumber String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  careRequests  CareRequest[]

  @@map("nurses")
}

model Pharmacist {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName      String
  pharmacyName  String?
  licenseNumber String?   @unique
  pharmacyId    String?
  pharmacy      Pharmacy? @relation(fields: [pharmacyId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([pharmacyId])
  @@map("pharmacists")
}

model Caregiver {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  relationship String?
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Linked Patients (M:N)
  patients       Patient[]       @relation("PatientCaregivers")
  caregiverTasks CaregiverTask[]

  @@map("caregivers")
}

model InsuranceProvider {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerName  String
  licenseNumber String?  @unique
  supportPhone  String?
  supportEmail  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  policies       InsurancePolicy[]

  @@map("insurance_providers")
}

// ============================================================
// 3. CLINICAL RECORDS & APPOINTMENTS
// ============================================================

model MedicalRecord {
  id          String     @id @default(cuid())
  patientId   String
  patient     Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId    String?
  doctor      Doctor?    @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  title       String
  type        RecordType @default(OTHER)
  hospital    String?
  fileUrl     String?    @db.Text
  fileName    String?
  fileSize    String?
  status      String     @default("Normal")
  isImportant Boolean    @default(false)
  notes       String?    @db.Text
  recordDate  DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@map("medical_records")
}

model Prescription {
  id         String             @id @default(cuid())
  patientId  String
  patient    Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId   String
  doctor     Doctor             @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  diagnosis  String?            @db.Text
  notes      String?            @db.Text
  status     PrescriptionStatus @default(PENDING_REVIEW)
  issuedAt   DateTime           @default(now())
  validUntil DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  items          PrescriptionItem[]
  pharmacyOrders PharmacyOrder[]

  @@index([patientId])
  @@index([doctorId])
  @@map("prescriptions")
}

model PrescriptionItem {
  id              String       @id @default(cuid())
  prescriptionId  String
  prescription    Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicineId      String?
  medicine        Medicine?    @relation(fields: [medicineId], references: [id], onDelete: SetNull)
  medicineName    String
  dosage          String
  unit            String
  frequency       String
  route           String?
  durationDays    Int?
  instructions    String?      @db.Text
  foodInstruction String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([prescriptionId])
  @@index([medicineId])
  @@map("prescription_items")
}

model Medicine {
  id            String    @id @default(cuid())
  name          String
  genericName   String?
  category      String?
  manufacturer  String?
  dosage        String?
  unit          String?
  stockQuantity Int       @default(0)
  unitPrice     Decimal   @default(0.0) @db.Decimal(10, 2)
  expiryDate    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  prescriptionItems PrescriptionItem[]
  orderItems        PharmacyOrderItem[]
  patientMedications PatientMedication[]

  @@map("medicines")
}

model Appointment {
  id                 String            @id @default(cuid())
  patientId          String
  patient            Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId           String
  doctor             Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointmentDate    DateTime
  slotTime           String
  type               AppointmentType   @default(VIDEO)
  status             AppointmentStatus @default(PENDING)
  fee                Decimal           @default(0.0) @db.Decimal(10, 2)
  reason             String?           @db.Text
  notes              String?           @db.Text
  meetingLink        String?           @db.Text
  cancellationReason String?           @db.Text
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  consultation       Consultation?

  @@index([patientId])
  @@index([doctorId])
  @@map("appointments")
}

model Consultation {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId     String
  patient       Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  status               ConsultationStatus @default(DRAFT)
  chiefComplaint       String?            @db.Text
  symptoms             String?            @db.Text
  clinicalNotes        String?            @db.Text
  diagnosis            String?            @db.Text
  treatmentPlan        String?            @db.Text
  followUpInstructions String?            @db.Text

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@map("consultations")
}

model Vital {
  id               String   @id @default(cuid())
  patientId        String
  patient          Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  recordedById     String?
  recordedBy       User?    @relation("VitalRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  systolicBp       Int?
  diastolicBp      Int?
  heartRate        Int?
  respiratoryRate  Int?
  oxygenSaturation Float?
  temperature      Float?
  bloodSugar       Float?
  weightKg         Float?
  notes            String?  @db.Text
  recordedAt       DateTime @default(now())

  @@index([patientId])
  @@index([recordedById])
  @@map("vitals")
}

model Reminder {
  id                   String         @id @default(cuid())
  patientId            String
  patient              Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title                String
  type                 ReminderType   @default(MEDICATION)
  scheduledTime        String
  frequency            String?
  startDate            DateTime?
  endDate              DateTime?
  status               ReminderStatus @default(ACTIVE)
  isCompletedToday     Boolean        @default(false)
  notes                String?        @db.Text
  sourcePrescriptionId String?
  doctorName           String?
  clinicName           String?
  followUpStatus       String?        @default("Pending")
  followUpDate         DateTime?
  priority             String?        @default("Normal")
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([patientId])
  @@map("reminders")
}

// ============================================================
// 4. PHARMACY & COMMERCE
// ============================================================

model Pharmacy {
  id            String   @id @default(cuid())
  pharmacyId    String   @unique
  name          String
  licenseNumber String?  @unique
  address       String?  @db.Text
  city          String?
  state         String?
  pincode       String?
  phone         String?
  email         String?
  isVerified    Boolean  @default(false)
  isActive      Boolean  @default(true)
  tieUpStatus   String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pharmacists Pharmacist[]
  orders      PharmacyOrder[]

  @@map("pharmacies")
}

model PharmacyOrder {
  id              String        @id @default(cuid())
  patientId       String
  patient         Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  prescriptionId  String?
  prescription    Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  pharmacyId      String?
  pharmacy        Pharmacy?     @relation(fields: [pharmacyId], references: [id], onDelete: SetNull)
  status          OrderStatus   @default(PENDING)
  totalAmount     Decimal       @default(0.0) @db.Decimal(10, 2)
  deliveryAddress String?       @db.Text
  deliveryType    String?       @default("Home Delivery")
  orderedAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items PharmacyOrderItem[]

  @@index([patientId])
  @@index([prescriptionId])
  @@index([pharmacyId])
  @@map("pharmacy_orders")
}

model PharmacyOrderItem {
  id           String        @id @default(cuid())
  orderId      String
  order        PharmacyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  medicineId   String?
  medicine     Medicine?     @relation(fields: [medicineId], references: [id], onDelete: SetNull)
  medicineName String
  dosage       String?
  quantity     Int           @default(1)
  unitPrice    Decimal       @default(0.0) @db.Decimal(10, 2)
  subtotal     Decimal       @default(0.0) @db.Decimal(10, 2)

  @@index([orderId])
  @@index([medicineId])
  @@map("pharmacy_order_items")
}

// ============================================================
// 5. NOTIFICATIONS, CARE REQUESTS & COMPLIANCE
// ============================================================

model CareRequest {
  id            String    @id @default(cuid())
  patientId     String
  patient       Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  nurseId       String?
  nurse         Nurse?    @relation(fields: [nurseId], references: [id], onDelete: SetNull)
  serviceType   String
  scheduledDate DateTime
  scheduledTime String
  location      String    @db.Text
  distanceKm    String?
  instructions  String?   @db.Text
  status        String    @default("Pending")
  otpPin        String?
  etaMinutes    Int?
  notes         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([patientId])
  @@index([nurseId])
  @@map("care_requests")
}

model Notification {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  message       String   @db.Text
  type          String   @default("SYSTEM")
  category      String?  @default("General")
  relatedModule String?
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  ipAddress  String?
  userAgent  String?
  details    String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ============================================================
// 6. HEALTH SHARE & QR ACCESS
// ============================================================

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  REVOKED
}

model HealthShareToken {
  id              String   @id @default(cuid())
  token           String   @unique
  patientId       String
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  durationMinutes Int      @default(60)
  expiresAt       DateTime
  isRevoked       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@index([patientId])
  @@index([token])
  @@map("health_share_tokens")
}

model PatientAccessRequest {
  id              String              @id @default(cuid())
  patientId       String
  patient         Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId        String
  doctor          Doctor              @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  tokenRef        String?
  purpose         String              @default("Patient Consultation")
  permissionScope String?             @db.Text // JSON string array
  durationMinutes Int                 @default(60)
  status          AccessRequestStatus @default(PENDING)
  requestedAt     DateTime            @default(now())
  respondedAt     DateTime?
  expiresAt       DateTime?
  grantedAt       DateTime?
  revokedAt       DateTime?
  notes           String?             @db.Text
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @default(now()) @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@map("patient_access_requests")
}

// ============================================================
// 7. PATIENT MEDICATIONS & DOSE TRACKING
// ============================================================

model PatientMedication {
  id              String    @id @default(cuid())
  patientId       String
  patient         Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medicineId      String?
  medicine        Medicine? @relation(fields: [medicineId], references: [id], onDelete: SetNull)
  name            String
  dosage          String
  unit            String    @default("mg")
  frequency       String    @default("Twice daily")
  route           String?   @default("Oral")
  startDate       DateTime?
  endDate         DateTime?
  prescribedBy    String?
  hospital        String?
  prescriptionNo  String?
  instructions    String?   @db.Text
  foodInstruction String?   @default("After Food")
  doseTimes       String?   @db.Text // JSON string array of times
  status          String    @default("active") // active, completed, paused
  totalDoses      Int       @default(30)
  takenDoses      Int       @default(0)
  skippedDoses    Int       @default(0)
  remainingDoses  Int       @default(30)
  refillReminder  Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  doseLogs        DoseLog[]

  @@index([patientId])
  @@index([medicineId])
  @@map("patient_medications")
}

model DoseLog {
  id                  String            @id @default(cuid())
  patientId           String
  patient             Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientMedicationId String
  patientMedication   PatientMedication @relation(fields: [patientMedicationId], references: [id], onDelete: Cascade)
  doseTime            String
  status              String            @default("upcoming") // upcoming, taken, skipped, missed
  takenAt             String?
  skippedReason       String?           @db.Text
  logDate             DateTime          @default(now())
  createdAt           DateTime          @default(now())

  @@index([patientId])
  @@index([patientMedicationId])
  @@map("dose_logs")
}

// ============================================================
// 8. CAREGIVER TASKS
// ============================================================

model CaregiverTask {
  id          String    @id @default(cuid())
  caregiverId String
  caregiver   Caregiver @relation(fields: [caregiverId], references: [id], onDelete: Cascade)
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title       String
  category    String    @default("Medication") // Medication, Vitals, Nutrition, Therapy, Exercise
  scheduledTime String
  status      String    @default("Pending") // Pending, Completed, Skipped
  completedAt DateTime?
  priority    String    @default("Normal") // Normal, High, Urgent
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([caregiverId])
  @@index([patientId])
  @@map("caregiver_tasks")
}

// ============================================================
// 9. INSURANCE POLICIES, CLAIMS, PRE-AUTH & SETTLEMENTS
// ============================================================

model InsurancePolicy {
  id                String            @id @default(cuid())
  insuranceId       String            @unique // e.g. INS-MC-2026-10245
  patientId         String
  patient           Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  providerId        String?
  provider          InsuranceProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  policyNumber      String            @unique
  policyName        String
  policyStatus      String            @default("Active") // Active, Inactive, Expired
  policyStartDate   DateTime
  policyEndDate     DateTime
  coverageAmount    Decimal           @default(0.0) @db.Decimal(12, 2)
  usedCoverage      Decimal           @default(0.0) @db.Decimal(12, 2)
  remainingCoverage Decimal           @default(0.0) @db.Decimal(12, 2)
  benefits          String?           @db.Text // JSON object of benefits
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  claims            InsuranceClaim[]
  preAuthorizations PreAuthorization[]

  @@index([patientId])
  @@index([providerId])
  @@map("insurance_policies")
}

model InsuranceClaim {
  id                  String           @id @default(cuid())
  claimId             String           @unique // e.g. CLM-8891-2026
  policyId            String
  policy              InsurancePolicy  @relation(fields: [policyId], references: [id], onDelete: Cascade)
  patientId           String
  patient             Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hospital            String
  treatment           String
  admissionDate       DateTime
  dischargeDate       DateTime
  submittedAmount     Decimal          @default(0.0) @db.Decimal(12, 2)
  approvedAmount      Decimal          @default(0.0) @db.Decimal(12, 2)
  patientContribution Decimal          @default(0.0) @db.Decimal(12, 2)
  status              String           @default("New") // New, Under Review, Approved, Partially Approved, Rejected, Settled
  documents           String?          @db.Text // JSON array of document objects
  timeline            String?          @db.Text // JSON array of timeline objects
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  settlements         ClaimSettlement[]

  @@index([policyId])
  @@index([patientId])
  @@map("insurance_claims")
}

model PreAuthorization {
  id                 String          @id @default(cuid())
  preAuthId          String          @unique // e.g. PA-9901-2026
  policyId           String
  policy             InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  hospitalName       String
  doctorName         String
  procedure          String
  estimatedCost      Decimal         @default(0.0) @db.Decimal(12, 2)
  requestedAmount    Decimal         @default(0.0) @db.Decimal(12, 2)
  status             String          @default("Pending") // Pending, Approved, Rejected, Need More Info
  responseNotes      String?         @db.Text
  submissionDate     DateTime        @default(now())
  actionDate         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([policyId])
  @@map("pre_authorizations")
}

model ClaimSettlement {
  id                String         @id @default(cuid())
  settlementId      String         @unique // e.g. STL-2026-001
  claimId           String
  claim             InsuranceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  paymentMode       String         @default("NEFT / Direct Bank Transfer")
  referenceNumber   String?
  paidAmount        Decimal        @default(0.0) @db.Decimal(12, 2)
  settlementDate    DateTime       @default(now())
  status            String         @default("Processed") // Processed, In Transit, Failed
  notes             String?        @db.Text
  createdAt         DateTime       @default(now())

  @@index([claimId])
  @@map("claim_settlements")
}

